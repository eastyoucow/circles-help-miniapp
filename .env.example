# Copy to .env.local for development. Set the same keys in the Vercel project.
# The Mini App must never receive these values.

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# Exact callback URL registered with Strava (path included).
# STRAVA_OAUTH_REDIRECT_URI=https://<your-vercel-domain>/api/strava/oauth/callback
# Optional. Falls back to TOKEN_ENCRYPTION_KEY.
# OAUTH_STATE_SECRET=
# Random string you choose. Strava sends it back as hub.verify_token when
# confirming the webhook subscription. Must match the verify_token in the
# POST to https://www.strava.com/api/v3/push_subscriptions
# STRAVA_WEBHOOK_VERIFY_TOKEN=

# Postgres fields from Supabase. Used by TypeORM.
# Local migrations: direct host db.[PROJECT-REF].supabase.co, user postgres, port 5432.
# Vercel: use the Session pooler (port 5432, not 6543). Host looks like
# aws-0-[region].pooler.supabase.com and user is postgres.[PROJECT-REF].
# DATABASE_HOST=aws-0-[region].pooler.supabase.com
# DATABASE_PORT=5432
# DATABASE_NAME=postgres
# DATABASE_USER=postgres.[PROJECT-REF]
# DATABASE_PASSWORD=
# DATABASE_SSL=true
# TYPEORM_LOGGING=false

# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Secret used to encrypt Strava tokens at rest. Prefer 64-char hex (32 bytes).
# Any other non-empty value is hashed with SHA-256.
# TOKEN_ENCRYPTION_KEY=

# Admin-only activity sync. Set at least one. The Mini App must never receive these.
# ADMIN_SECRET= a long random string; send as X-Admin-Secret or Bearer token
# ADMIN_TELEGRAM_USER_ID= your Telegram numeric user id (initData must match)
