# Copy to .env.local for development. Set the same keys in the Vercel project.
# The Mini App must never receive these values.

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_WEBHOOK_VERIFY_TOKEN=

# Postgres URI from Supabase (direct connection, port 5432). Used by TypeORM.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# DATABASE_SSL=true
# TYPEORM_LOGGING=false

# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# TOKEN_ENCRYPTION_KEY=
